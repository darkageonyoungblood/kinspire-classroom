{
  "name": "kinspire-classroom",
  "main": "index.js",
  "compatibility_date": "2026-09-01",

  // Everything is inside the Worker, including the one image, so there is no
  // assets directory and no folders anywhere. Six files, all side by side.

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "BOARD", "class_name": "Board" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Board"] }
  ],

  "observability": { "enabled": true }
}
